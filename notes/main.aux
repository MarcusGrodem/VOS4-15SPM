\newlabel{thr:risk-sharing}{{41}{142}{Risk sharing (risikodeling)}{section.41}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{142}{section*.469}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {64}{\ignorespaces \textbf  {Trade-offen risikodeling vs.\ insentiver.} Ved $\beta = 0$ (fastlønn): effektiv risikodeling, men maksimal shirking. Ved $\beta = 1$ (full residual claimancy): null shirking, men risikopremien koster prinsipalen $r\sigma ^2/2$. Second-best $\beta ^*$ minimerer summen og ligger strengt mellom 0 og 1. [SLIDE -- BSZ kap.\ 15, slide 7]}}{144}{figure.64}\protected@file@percent }
