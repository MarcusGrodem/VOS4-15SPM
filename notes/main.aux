\@writefile{toc}{\contentsline {section}{\numberline {39}Optimal effort-modell (agent- og prinsipalside)}{135}{section.39}\protected@file@percent }
\newlabel{thr:optimal-effort-model}{{39}{135}{Optimal effort-modell (agent- og prinsipalside)}{section.39}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{135}{section*.447}\protected@file@percent }
\newlabel{eq:agent-foc}{{1}{136}{Modell A -- Agentens side (innsatsvalg)}{equation.39.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {60}{\ignorespaces \textbf  {Modell A -- agentens side.} Agenten velger $e^{*}$ der $MB=MC$, dvs.\ $\beta \alpha =c'(e)$. Når $\beta $ stiger fra $\beta _1$ til $\beta _2$, skifter $MB$ opp og optimal innsats $e^{*}$ flyttes til høyre. Fast lønn $W_0$ påvirker \emph  {ikke} kurvene og dermed ikke $e^{*}$. [SLIDE -- BSZ kap.\ 15]}}{136}{figure.60}\protected@file@percent }
\newlabel{eq:beta-star}{{2}{137}{Modell B -- Prinsipalens side (optimal $\beta $)}{equation.39.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {61}{\ignorespaces \textbf  {Modell B -- prinsipalens side.} Prinsipalen velger $\beta ^{*}$ der marginalt insentivutbytte ($MB(\beta )$, konkav stigende -- avtagende marginalgevinst av flere insentiver) lik marginal risikokostnad ($MC(\beta )$, konveks stigende -- risikopremien $\genfrac  {}{}{}1{r}{2}\beta ^{2}\sigma ^{2}$ stiger raskere enn lineært). $\beta ^{*}<1$ i second-best; $\beta ^{*}\to 1$ kun ved risikonøytral agent ($r=0$) eller perfekt observerbarhet ($\sigma ^{2}=0$). [SLIDE -- BSZ kap.\ 15]}}{137}{figure.61}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {62}{\ignorespaces Prinsipal-agent-modellen i BSZ kap.\ 15: $Q=\alpha e+\mu $, $W=W_0+\beta Q$, og effort-valget som funksjon av $\beta $. [SLIDE -- BSZ kap.\ 15, slide 14]}}{138}{figure.62}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{139}{section*.458}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {40}Incitamentskoefficient ($\beta $)}{139}{section.40}\protected@file@percent }
\newlabel{thr:incentive-coefficient}{{40}{139}{Incitamentskoefficient ($\beta $)}{section.40}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{139}{section*.459}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {63}{\ignorespaces Faktorer som favoriserer høy $\beta $: høy $\alpha $ (innsats slår igjennom på output), lavt $\sigma ^2$ (lite støy), lav risikoaversjon $r$ (agent tåler å bære risiko), og fleksibel innsats. Optimal $\beta ^* = \alpha ^2 / (\alpha ^2 + r\sigma ^2 C''(e))$. [SLIDE -- BSZ kap.\ 15, slide 18]}}{141}{figure.63}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{142}{section*.468}\protected@file@percent }
