\@writefile{lof}{\contentsline {figure}{\numberline {72}{\ignorespaces Spesialisert produksjonsutstyr (robotarm-fabrikk): make-or-buy-beslutningen avhenger av aktivaspesifisitet -- jo mer relasjonsspesifik investering, desto sterkere argument for vertikal integrasjon for å redusere hold-up-risiko og transaksjonskostnader. (BSZ kap.\ 8, slide 9) [SLIDE]}}{168}{figure.72}\protected@file@percent }
