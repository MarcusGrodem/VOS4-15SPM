\@writefile{lof}{\contentsline {figure}{\numberline {65}{\ignorespaces Lønnskontrakten dekomponert: fast del ($W_0$, dekker reservation utility og risikopremie) + variabel del ($\beta Q$, vrir innsats). Helningen $\beta $ er insentivkoeffisienten -- jo brattere, jo sterkere insentiv, men jo mer risiko bæres av agenten. [SLIDE -- BSZ kap.\ 15, slide 20]}}{146}{figure.65}\protected@file@percent }
