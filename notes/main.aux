\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{176}{section*.596}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {77}{\ignorespaces Markedsstrukturer fra perfekt konkurranse til monopol. Regulering griper inn der markedsmakt gir $P > MC$. (BSZ kap.\ 6, slide 3) [SLIDE]}}{178}{figure.77}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{179}{section*.604}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {56}Regulated pricing-modellen (branche-profit og political support)}{179}{section.56}\protected@file@percent }
\newlabel{thr:regulated-pricing-model}{{56}{179}{Regulated pricing-modellen (branche-profit og political support)}{section.56}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{179}{section*.605}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {78}{\ignorespaces \textbf  {Regulated pricing-modellen.} Brancheprofitt $\pi (P)$ (blå) er invers-U med topp ved monopolpris $P^M$. Konsumentoverskudd $CS(P)$ (grønn) er fallende. Political support $S(P)$ (rød) balanserer de to og topper ved $P^*$ -- mellom $P^{MC}$ og $P^M$. Regulatoren velger $P^*$ der marginal politisk gevinst fra bransjen lik marginal politisk kostnad fra konsumenter. [BOK -- BSZ kap.\ 21]}}{180}{figure.78}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{181}{section*.614}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {57}Informativeness-prinsippet}{181}{section.57}\protected@file@percent }
\newlabel{thr:informativeness-principle}{{57}{181}{Informativeness-prinsippet}{section.57}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{181}{section*.615}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {79}{\ignorespaces \textbf  {Informativeness-prinsippet.} Agenten velger innsats $e$, som påvirker primærmål $Q$ (med støy $\sigma ^2$). Et tilleggssignal $y$ inkluderes i kontrakten \emph  {bare} hvis det er informativt om $e$ -- altså endrer den statistiske inferensen om $e$ gitt $Q$. Resultat: lavere effektiv støy $\sigma ^2_{\text  {eff}}$, lavere risikopremie, sterkere insentiver mulig. [SLIDE/BOK]}}{183}{figure.79}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{183}{section*.623}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {58}Integrity vs.\ Income-modellen}{184}{section.58}\protected@file@percent }
\newlabel{thr:integrity-vs-income-model}{{58}{184}{Integrity vs.\ Income-modellen}{section.58}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{184}{section*.624}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {80}{\ignorespaces Metafor: pengeankret drar agenten ned. Et aggressivt insentivsystem øker den personlige kostnaden ved å forbli etisk -- selv en agent som verdsetter integritet, kan dras mot uetisk atferd når relativprisen mellom integritet og inntekt endres tilstrekkelig. (BSZ kap.\ 2, slide 5) [SLIDE]}}{184}{figure.80}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {81}{\ignorespaces \textbf  {Integrity vs.\ Income.} Med moderat insentiv (blå $B_1$) velger agenten punkt $A$: høy integritet, moderat inntekt. Etter innføring av aggressivt prestasjonsbasert insentiv (rød $B_2$) roterer budsjettlinjen utover -- gevinsten ved å ofre integritet øker. Nytt optimum er punkt $B$: lav integritet, høy inntekt. Kompensasjonsdesignet endrer etisk atferd uten å endre preferanser. [SLIDE -- BSZ kap.\ 2]}}{185}{figure.81}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{186}{section*.632}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {59}Risk--Expected Value-modellen (indifferenskurver i $(\sigma , E[W])$-rommet)}{186}{section.59}\protected@file@percent }
\newlabel{thr:risk-expected-value-model}{{59}{186}{Risk--Expected Value-modellen (indifferenskurver i $(\sigma , E[W])$-rommet)}{section.59}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{186}{section*.633}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {82}{\ignorespaces Shirking: risikoavers agent med lav $\beta $ velger lav innsats -- risiko--forventet verdi-modellen forklarer trade-off mellom risiko og motivasjon. (BSZ kap.\ 15, slide 2) [SLIDE]}}{187}{figure.82}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {83}{\ignorespaces \textbf  {Risk--Expected Value.} Indifferenskurver i $(\sigma _W, E[W])$-rommet. Risikoavers agent (blå): stigende, konvekse kurver -- krever høyere $E[W]$ for mer risiko. Punkt $A$: en kontrakt med risiko $\sigma _A$ krever forventet lønn $E[W]_A$; agentens certainty equivalent er $CE$ (skjæring med $y$-aksen). Risikopremien $RP = E[W]_A - CE$ er prinsiplens kostnad. Risikonøytral agent (grønn): flat kurve -- ingen risikopremie nødvendig. [SLIDE -- BSZ kap.\ 2/15]}}{187}{figure.83}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{188}{section*.641}\protected@file@percent }
\gdef \@abspage@last{188}
