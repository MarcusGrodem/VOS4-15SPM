\@writefile{lof}{\contentsline {figure}{\numberline {75}{\ignorespaces Free-rider-problemet i hverdagen: oppvasken ingen tar -- alle nyter godt av et rent kjøkken, men ingen vil bære kostnaden alene. (BSZ kap.\ 9, slide 15) [SLIDE]}}{175}{figure.75}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{176}{section*.587}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {54}Double markup-problemet (dobbel marginalisering)}{176}{section.54}\protected@file@percent }
\newlabel{thr:double-markup-problem}{{54}{176}{Double markup-problemet (dobbel marginalisering)}{section.54}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{176}{section*.588}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {76}{\ignorespaces \textbf  {Double markup.} Med to uavhengige monopolister (oppstrøms og nedstrøms) ender sluttprisen på 80 med kvantum 20 (rødt punkt). Vertikal integrasjon gir $P=60$, $Q=40$ (svart punkt) -- lavere pris, høyere kvantum, eliminert dødvektstap (DWL). [BOK -- BSZ kap.\ 19]}}{178}{figure.76}\protected@file@percent }
