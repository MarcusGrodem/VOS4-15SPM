\newlabel{thr:double-markup-problem}{{54}{174}{Double markup-problemet (dobbel marginalisering)}{section.54}{}}
\@writefile{toc}{\contentsline {paragraph}{Definisjon.}{174}{section*.586}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {76}{\ignorespaces \textbf  {Double markup.} Med to uavhengige monopolister (oppstrøms og nedstrøms) ender sluttprisen på 80 med kvantum 20 (rødt punkt). Vertikal integrasjon gir $P=60$, $Q=40$ (svart punkt) -- lavere pris, høyere kvantum, eliminert dødvektstap (DWL). [BOK -- BSZ kap.\ 19]}}{176}{figure.76}\protected@file@percent }
