\@writefile{lof}{\contentsline {figure}{\numberline {75}{\ignorespaces Free-rider-problemet i hverdagen: oppvasken ingen tar -- alle nyter godt av et rent kjøkken, men ingen vil bære kostnaden alene. (BSZ kap.\ 9, slide 15) [SLIDE]}}{173}{figure.75}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Brukt i spørsmål:}{174}{section*.585}\protected@file@percent }
